{
  "dialogues": {
    "elder_aldrin_dialogue": {
      "entryNodes": [
        {
          "condition": {
            "questStageEquals": {
              "questId": "main_lost_watchers",
              "stageId": "return_to_elder"
            }
          },
          "nodeId": "elder_finale"
        },
        {
          "condition": {
            "questCompleted": "main_lost_watchers"
          },
          "nodeId": "elder_post_quest"
        },
        {
          "condition": {
            "questActive": "main_lost_watchers"
          },
          "nodeId": "elder_reminder"
        },
        {
          "nodeId": "elder_greeting"
        }
      ],
      "nodes": {
        "elder_greeting": {
          "speaker": "村长奥尔德林",
          "text": "欢迎来到溪谷村，旅人。这几天夜里，东边的废弃哨塔竟重新燃起了烽火，森林里的亡灵与哥布林也愈发躁动。我怀疑古代守望者的封印正在松动。",
          "choices": [
            {
              "text": "我愿意去调查废弃哨塔，查明真相。",
              "action": {
                "type": "startQuest",
                "questId": "main_lost_watchers"
              },
              "nextNodeId": "elder_accepted"
            },
            {
              "text": "这里附近还有哪些地方需要留意？",
              "nextNodeId": "elder_lore"
            },
            {
              "text": "我先四处转转，稍后再来。",
              "nextNodeId": null
            }
          ]
        },
        "elder_lore": {
          "speaker": "村长奥尔德林",
          "text": "西面是灰木森林，东面跨过河谷就是高地上的废弃哨塔，而正北方的山崖深处……埋藏着守望者的古代墓穴。铁匠葛伦和猎人莱拉也在村里，他们或许能帮到你。",
          "choices": [
            {
              "text": "明白了，我去调查废弃哨塔。（接取主线《失落的守望者》）",
              "action": {
                "type": "startQuest",
                "questId": "main_lost_watchers"
              },
              "nextNodeId": "elder_accepted"
            },
            {
              "text": "感谢提醒。",
              "nextNodeId": null
            }
          ]
        },
        "elder_accepted": {
          "speaker": "村长奥尔德林",
          "text": "愿星辰指引你的脚步。先前往东侧高地的废弃哨塔看看吧，如果当年留守的守望者留下了记录，线索一定还在塔内。",
          "choices": [
            {
              "text": "我立刻动身。",
              "nextNodeId": null
            }
          ]
        },
        "elder_reminder": {
          "speaker": "村长奥尔德林",
          "text": "哨塔上的火焰仍未熄灭，北山的雾气也越来越浓。请尽早找回守望者的圣物与真相。",
          "choices": [
            {
              "text": "我会尽快完成调查。",
              "nextNodeId": null
            }
          ]
        },
        "elder_finale": {
          "speaker": "村长奥尔德林",
          "text": "你竟然真的从古代墓穴中平安归来，还带回了《守望者圣物》！只要将圣物嵌入村中的结界石台，边境便能重归安宁。但我也看得出，这件圣物本身蕴含着强大的战力……你打算如何处置它？",
          "choices": [
            {
              "text": "【交还圣物】重塑边境结界，守护溪谷村（+300 XP，+250 金币，永久+5防御/+25生命上限）",
              "condition": {
                "hasItem": {
                  "itemId": "watchers_relic",
                  "quantity": 1
                }
              },
              "action": {
                "type": "completeMainChoice",
                "questId": "main_lost_watchers",
                "outcome": "return_relic",
                "consumeItemId": "watchers_relic",
                "flag": "ending_guardian"
              },
              "nextNodeId": "elder_ending_guardian"
            },
            {
              "text": "【保留圣物】只有绝对的力量才能应对未来的黑暗（保留可装备圣物，+200 XP）",
              "action": {
                "type": "completeMainChoice",
                "questId": "main_lost_watchers",
                "outcome": "keep_relic",
                "flag": "ending_renegade"
              },
              "nextNodeId": "elder_ending_renegade"
            }
          ]
        },
        "elder_ending_guardian": {
          "speaker": "村长奥尔德林",
          "text": "圣光重新笼罩了灰烬边境！你无私的抉择拯救了整片谷地。溪谷村将永远铭记守护者的恩情，愿这份祝福永远庇佑着你。",
          "choices": [
            {
              "text": "这是我应尽之责。",
              "nextNodeId": null
            }
          ]
        },
        "elder_ending_renegade": {
          "speaker": "村长奥尔德林",
          "text": "……看来你选择自己背负这份沉重的力量。我无法强求，只盼你切勿被圣物中的余烬吞噬心智，善用它吧。",
          "choices": [
            {
              "text": "我自有分寸。",
              "nextNodeId": null
            }
          ]
        },
        "elder_post_quest": {
          "speaker": "村长奥尔德林",
          "text": "边境的危机暂时平息，多亏了你的果断行动。但自由探索才刚刚开始，灰烬边境仍有秘密等待发掘。",
          "choices": [
            {
              "text": "后会有期，长老。",
              "nextNodeId": null
            }
          ]
        }
      }
    },
    "merchant_garrick_dialogue": {
      "entryNodes": [
        {
          "condition": {
            "questStageEquals": {
              "questId": "side_frontier_herbs",
              "stageId": "deliver_garrick"
            }
          },
          "nodeId": "garrick_deliver"
        },
        {
          "nodeId": "garrick_greeting"
        }
      ],
      "nodes": {
        "garrick_greeting": {
          "speaker": "铁匠商人葛伦",
          "text": "打铁声可吓不跑林子里的怪物！需要趁手的武器、盔甲还是救命药水？我这里货真价实。",
          "choices": [
            {
              "text": "让我看看你的货摊。（打开商店）",
              "action": {
                "type": "openShop",
                "npcId": "merchant_garrick"
              },
              "nextNodeId": null
            },
            {
              "text": "村里现在急缺什么补给吗？（查看支线任务）",
              "condition": {
                "questNotStarted": "side_frontier_herbs"
              },
              "nextNodeId": "garrick_quest_offer"
            },
            {
              "text": "灰烬草我还在继续收集。",
              "condition": {
                "questActive": "side_frontier_herbs"
              },
              "nextNodeId": null
            },
            {
              "text": "暂时不用，回头再聊。",
              "nextNodeId": null
            }
          ]
        },
        "garrick_quest_offer": {
          "speaker": "铁匠商人葛伦",
          "text": "伤兵和猎人都需要治疗药剂，但我库存的【灰烬草】快见底了。如果你能在灰木森林或河谷一带帮我采来 3 株，我不仅付你工钱，还送你两瓶强效治疗药水！",
          "choices": [
            {
              "text": "包在我身上。（接取《边境物资筹备》）",
              "action": {
                "type": "startQuest",
                "questId": "side_frontier_herbs"
              },
              "nextNodeId": null
            },
            {
              "text": "先让我看看商店商品。",
              "action": {
                "type": "openShop",
                "npcId": "merchant_garrick"
              },
              "nextNodeId": null
            }
          ]
        },
        "garrick_deliver": {
          "speaker": "铁匠商人葛伦",
          "text": "太好了，这 3 株灰烬草成色极佳！拿好你的金币和强效治疗药水，去闯荡北方山麓时一定要保重！",
          "choices": [
            {
              "text": "交付 3 株灰烬草并领取奖励",
              "action": {
                "type": "completeQuest",
                "questId": "side_frontier_herbs",
                "outcome": "default",
                "consumeItemId": "ashen_herb",
                "consumeQuantity": 3
              },
              "nextNodeId": null
            },
            {
              "text": "顺便看看商店。",
              "action": {
                "type": "openShop",
                "npcId": "merchant_garrick"
              },
              "nextNodeId": null
            }
          ]
        }
      }
    },
    "hunter_lyra_dialogue": {
      "entryNodes": [
        {
          "condition": {
            "questStageEquals": {
              "questId": "side_goblin_menace",
              "stageId": "report_lyra"
            }
          },
          "nodeId": "lyra_complete"
        },
        {
          "condition": {
            "questCompleted": "side_goblin_menace"
          },
          "nodeId": "lyra_after"
        },
        {
          "condition": {
            "questActive": "side_goblin_menace"
          },
          "nodeId": "lyra_progress"
        },
        {
          "nodeId": "lyra_greeting"
        }
      ],
      "nodes": {
        "lyra_greeting": {
          "speaker": "猎人莱拉",
          "text": "嘘……我刚从西边的灰木森林潜伏回来。那群灰木哥布林最近胆子越来越大，甚至在林间空地扎了营。",
          "choices": [
            {
              "text": "需要我去清理它们吗？（接取《灰木林的威胁》）",
              "action": {
                "type": "startQuest",
                "questId": "side_goblin_menace"
              },
              "nextNodeId": "lyra_accepted"
            },
            {
              "text": "灰木林里有什么需要注意的？",
              "nextNodeId": "lyra_tips"
            },
            {
              "text": "我只是路过打个招呼。",
              "nextNodeId": null
            }
          ]
        },
        "lyra_tips": {
          "speaker": "猎人莱拉",
          "text": "哥布林喜欢成群行动，善用火球术（右键）先手削弱它们，再用长剑近战解决。林子更深处还藏着一座古老祭坛。",
          "choices": [
            {
              "text": "我去帮你消灭 3 名灰木哥布林。（接取任务）",
              "action": {
                "type": "startQuest",
                "questId": "side_goblin_menace"
              },
              "nextNodeId": "lyra_accepted"
            },
            {
              "text": "多谢忠告。",
              "nextNodeId": null
            }
          ]
        },
        "lyra_accepted": {
          "speaker": "猎人莱拉",
          "text": "太好了！向西走进入灰木森林，解决掉 3 个哥布林掠夺者后回来找我，我把备用的猎人短剑和赏金一起给你。",
          "choices": [
            {
              "text": "交给我吧。",
              "nextNodeId": null
            }
          ]
        },
        "lyra_progress": {
          "speaker": "猎人莱拉",
          "text": "灰木森林就在村庄正西面。小心哥布林的围攻，解决 3 个就回来复命。",
          "choices": [
            {
              "text": "正在处理。",
              "nextNodeId": null
            }
          ]
        },
        "lyra_complete": {
          "speaker": "猎人莱拉",
          "text": "干得漂亮！森林商路的威胁总算减轻了不少。这把《猎人短剑》和 100 金币归你了，祝你在哨塔和墓穴好运！",
          "choices": [
            {
              "text": "收下奖励",
              "action": {
                "type": "completeQuest",
                "questId": "side_goblin_menace",
                "outcome": "default"
              },
              "nextNodeId": null
            }
          ]
        },
        "lyra_after": {
          "speaker": "猎人莱拉",
          "text": "自从你清剿了营地，灰木林边缘安静多了。不过北面古代墓穴传出的寒气仍让人不安。",
          "choices": [
            {
              "text": "我会小心应对的。",
              "nextNodeId": null
            }
          ]
        }
      }
    },
    "city_gate_captain_dialogue": {
      "entryNodes": [{ "nodeId": "captain_greeting" }],
      "nodes": {
        "captain_greeting": {
          "speaker": "守门队长马库斯",
          "text": "欢迎通过曲轴双门瓮城进入【灰烬城 (Ashenhold)】！全城八大区域现已全面贯通：向北经贸易街可达【中央拱廊市集】，两侧分通【西翼工匠锻坊】与【东翼居民高地】，更可一路登临【圣伊格尼斯大圣堂】与山巅【领主城堡议事大厅】。",
          "choices": [
            { "text": "城里有哪些隐秘捷径或高处路线？", "nextNodeId": "captain_tour" },
            { "text": "多谢指引，我这就进城探索。", "nextNodeId": null }
          ]
        },
        "captain_tour": {
          "speaker": "守门队长马库斯",
          "text": "瓮城东侧防卫塔和门后石阶都能登上 +9.5 米城墙步道；城底 -4 米的【黑石排水暗渠】更是四通八达——不仅连通瓮城、酒馆酒窖与中央市集，听说最北端还藏着直达城堡军械库的暗井密道！",
          "choices": [{ "text": "太棒了，我去亲自走一遭。", "nextNodeId": null }]
        }
      }
    },
    "city_guard_sentinel_dialogue": {
      "entryNodes": [{ "nodeId": "sentinel_greeting" }],
      "nodes": {
        "sentinel_greeting": {
          "speaker": "瓮城巡卫凯尔",
          "text": "外城门故意偏筑在西侧，攻城敌军一进门就会撞上折角照壁与卫塔射界。西墙根下那道石阶通往地下暗渠，东边防卫塔则能直接爬上城墙女墙！",
          "choices": [{ "text": "辛苦执勤了。", "nextNodeId": null }]
        }
      }
    },
    "city_tavern_keeper_dialogue": {
      "entryNodes": [{ "nodeId": "greta_hi" }],
      "nodes": {
        "greta_hi": {
          "speaker": "老板娘格蕾塔",
          "text": "快进来烤烤火！余烬酒馆一楼有热黑麦包和药酒，顺着屋里木梯上二楼客房，不仅能俯瞰贸易街，北门还直通跨街哥特石桥与东侧居民高地呢。",
          "choices": [
            {
              "text": "来点热食与补给（打开酒馆柜台）",
              "action": { "type": "openShop", "npcId": "city_tavern_keeper" },
              "nextNodeId": null
            },
            { "text": "听说后院下面还有座酒窖？", "nextNodeId": "greta_cellar" }
          ]
        },
        "greta_cellar": {
          "speaker": "老板娘格蕾塔",
          "text": "嘘……穿过南边商队货栈到后院，就有石阶下到 -4 米酒窖。酒窖西墙连着古老的黑石暗渠，走私客留下的木箱说不定还在里头！",
          "choices": [{ "text": "多谢告知！", "nextNodeId": null }]
        }
      }
    },
    "city_apothecary_lian_dialogue": {
      "entryNodes": [{ "nodeId": "lian_hi" }],
      "nodes": {
        "lian_hi": {
          "speaker": "草药师莉安",
          "text": "刚研磨好的灰烬草疗伤剂和秘银法力药水，进山或下暗渠前备上几瓶吧！",
          "choices": [
            {
              "text": "查看草药铺货架（打开商店）",
              "action": { "type": "openShop", "npcId": "city_apothecary_lian" },
              "nextNodeId": null
            },
            { "text": "稍后再来。", "nextNodeId": null }
          ]
        }
      }
    },
    "city_merchant_elena_dialogue": {
      "entryNodes": [{ "nodeId": "elena_greeting" }],
      "nodes": {
        "elena_greeting": {
          "speaker": "药商伊琳娜",
          "text": "欢迎来到中央拱廊市集！听见西拱廊墙后传来的打铁声了吗？穿过喷泉正西那道哥特石拱门，就能拾级登上【西侧工匠区】的大锻坊！",
          "choices": [
            {
              "text": "看看店里的商品（打开商店）",
              "action": { "type": "openShop", "npcId": "city_merchant_elena" },
              "nextNodeId": null
            },
            { "text": "我正想去工匠区看看。", "nextNodeId": null }
          ]
        }
      }
    },
    "city_baker_marta_dialogue": {
      "entryNodes": [{ "nodeId": "marta_hi" }],
      "nodes": {
        "marta_hi": {
          "speaker": "烘焙娘玛尔塔",
          "text": "刚出炉的黑麦面包！身后的【市集百货烘焙双层商行】大门敞开着，从一楼烤炉旁爬木梯上二楼账房，东门廊桥能直接穿楼走进【东侧居民高地】哟！",
          "choices": [
            {
              "text": "买些热腾腾的干粮（打开面包摊）",
              "action": { "type": "openShop", "npcId": "city_baker_marta" },
              "nextNodeId": null
            },
            { "text": "穿楼捷径真巧妙，我去试试！", "nextNodeId": null }
          ]
        }
      }
    },
    "city_merchant_thorne_dialogue": {
      "entryNodes": [{ "nodeId": "thorne_hi" }],
      "nodes": {
        "thorne_hi": {
          "speaker": "商会总管索恩",
          "text": "旅人，这座围合市集是灰烬城八大箱庭的枢纽：西拱门上铁砧工匠区，东石阶登居民高地，北双折阶梯直通圣堂与山巅【领主城堡】。",
          "choices": [
            {
              "text": "查看商会精选货品（打开商会行店）",
              "action": { "type": "openShop", "npcId": "city_merchant_thorne" },
              "nextNodeId": null
            },
            { "text": "北面圣堂与领主城堡也开放了吗？", "nextNodeId": "thorne_north" }
          ]
        },
        "thorne_north": {
          "speaker": "商会总管索恩",
          "text": "千真万确！无论是从东西两翼北坡拾级而上，还是攀登北堡垒外悬崖石阶踏上 +19.5 米高架天桥，都能抵达【圣伊格尼斯大圣堂】与【灰烬领主城堡议事大厅】。",
          "choices": [{ "text": "我这就动身前往高城区。", "nextNodeId": null }]
        }
      }
    },
    "city_townsfolk_aldous_dialogue": {
      "entryNodes": [{ "nodeId": "aldous_hi" }],
      "nodes": {
        "aldous_hi": {
          "speaker": "市民奥尔德斯",
          "text": "咱们灰烬城依断崖而建，高墙窄巷挡住了山谷寒风。若想一览全城壮丽全景，去爬圣堂西侧那座 +24.2 米高的钟楼，或者登上城堡 +30.5 米的主瞭望塔吧！",
          "choices": [{ "text": "多谢老丈指点。", "nextNodeId": null }]
        }
      }
    },
    "city_smith_brennan_dialogue": {
      "entryNodes": [{ "nodeId": "brennan_hi" }],
      "nodes": {
        "brennan_hi": {
          "speaker": "铁匠大师布伦南",
          "text": "铛！铛！听见我这双烟囱大锻炉的锤音了吧？顺着锻坊里的木梯上二楼阁楼，外头的木栈道能直接跨上市集西城墙步道；往北爬崖边石阶则直达圣堂前庭！",
          "choices": [
            {
              "text": "挑选大锻坊精锻兵刃与板甲（打开铁匠店）",
              "action": { "type": "openShop", "npcId": "city_smith_brennan" },
              "nextNodeId": null
            },
